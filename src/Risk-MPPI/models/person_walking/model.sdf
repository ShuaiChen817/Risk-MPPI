<?xml version="1.0" ?>
<sdf version="1.5">
  <model name="person_walking">
    <link name="link">
      <inertial>
        <pose>0 0 0.95 0 0 0</pose>
        <!-- 如果希望质量也按体积缩放，可把 80 改成 80*0.8^3 ≈ 41 -->
        <mass>80.0</mass>
        <inertia>
          <ixx>27.82</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>24.88</iyy>
          <iyz>0</iyz>
          <izz>4.57</izz>
        </inertia>
      </inertial>

      <!-- “垫脚”的底部碰撞盒，整体按 0.8 缩放 -->
      <collision name="bottom">
        <pose>0 0 0.01 0 0 0</pose>
        <geometry>
          <box>
            <!-- 0.35 0.75 0.02 乘以 0.8 -->
            <size>0.28 0.60 0.016</size>
          </box>
        </geometry>
      </collision>

      <!-- 人体的碰撞几何：mesh + scale=0.8 -->
      <collision name="person">
        <pose>0 0 -0.02 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://person_walking/meshes/walking.dae</uri>
            <scale>0.8 0.8 0.8</scale>
          </mesh>
        </geometry>
      </collision>

      <!-- 视觉几何：同样加 scale=0.8 -->
      <visual name="visual">
        <pose>0 0 -0.02 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://person_walking/meshes/walking.dae</uri>
            <scale>0.8 0.8 0.8</scale>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>

