<?xml version="1.0"?>
<sdf version="1.6">
  <world name="default">
    <plugin name="gazebo_ros_init"    filename="libgazebo_ros_init.so"/>
    <plugin name="gazebo_ros_factory" filename="libgazebo_ros_factory.so"/>
    <plugin name="gazebo_ros_state"   filename="libgazebo_ros_state.so">
  <!-- 可选：如果你的代码订阅的是 /model_states_demo，就保留这行重映射。
       若订阅 /model_states 或 /gazebo/model_states，就把下面这一行删掉或改对应名字。 -->
  <!-- <ros>
    <argument>model_states:=model_states_demo</argument>
  </ros> -->
  <update_rate>30.0</update_rate>
</plugin>

    <!-- <plugin name='set_entity_state_plugin' filename='libset_entity_state.so'>
      <robot_name>my_robot</robot_name>
    </plugin> -->
    
    <!-- <plugin name='gazebo_ros_state' filename='libgazebo_ros_state.so'>
      <ros>
        <argument>model_states:=model_states_demo</argument>
      </ros>
      <update_rate>1.0</update_rate>
    </plugin> -->

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <include>
      <uri>model://sun</uri>
    </include>

    <scene>
      <shadows>false</shadows>
    </scene>

    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose frame=''>0.319654 -0.235002 9.29441 0 1.5138 0.009599</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.400000</sor>
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000.000000</contact_max_correcting_vel>
          <contact_surface_layer>0.01000</contact_surface_layer>
        </constraints>
      </ode>
    </physics>
     
    <include>
      <pose>0 -3.5 0.01 0.0 0.0 1.57</pose>
      <uri>model://turtlebot3_waffle_pi</uri>
    </include>
    
<!-- Cylinder positions in a circular layout with radius 9.0 meters -->
<include>
  <name>cylinder_1</name>
  <uri>model://cylinder_model</uri>
  <pose>9.0 0.0 0 0 0 0</pose> <!-- Cylinder 1 -->
</include>

<include>
  <name>cylinder_2</name>
  <uri>model://cylinder_model</uri>
  <pose>7.281 5.291 0 0 0 0</pose> <!-- Cylinder 2 -->
</include>

<include>
  <name>cylinder_3</name>
  <uri>model://cylinder_model</uri>
  <pose>2.781 8.559 0 0 0 0</pose> <!-- Cylinder 3 -->
</include>


    

  </world>
</sdf>
